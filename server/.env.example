PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=<64 char hex>
JWT_REFRESH_SECRET=<64 char hex>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AES-256-GCM encryption key — must be exactly 32 bytes (64 hex chars)
AES_ENCRYPTION_KEY=<64 char hex>

# Cloudinary (student photo + ID document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo transactional email (never SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Security tunables
FAILED_LOGIN_LIMIT=5
LOCKOUT_DURATION_MINUTES=15
OTP_COOLDOWN_SECONDS=60
OTP_EXPIRY_MINUTES=10
BULK_ACCESS_LIMIT=30
BULK_ACCESS_WINDOW_MINUTES=5
ANOMALY_ESCALATION_THRESHOLD=60
ANOMALY_SCAN_CRON=*/5 * * * *
